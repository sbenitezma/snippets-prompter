# Dependencies installed by npm (regenerated with `npm install`)
node_modules/

# Build output and test coverage (regenerated from source)
dist/
coverage/

# Real environment variables (secrets). Only .env.example is committed
.env

# Personal Claude Code settings (local permissions)
.claude/settings.local.json

# Session working notes — operational scratch file, not documentation.
# Always exists locally for session continuity; never committed.
NEXT-STEP.md
# TypeScript incremental build cache (regenerated by tsc)
*.tsbuildinfo

# Vite dependency pre-bundling cache (regenerated automatically)
.vite/
